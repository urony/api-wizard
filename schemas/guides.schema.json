{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "guides"],
  "properties": {
    "schemaVersion": { "enum": [1] },
    "guides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "providerId", "steps"],
        "properties": {
          "id": { "type": "string" },
          "providerId": { "type": ["string", "null"] },
          "title": { "type": "string" },
          "linkStep": { "type": "number" },
          "link": {
            "type": "object",
            "required": ["url", "label"],
            "properties": { "url": { "type": "string", "pattern": "^https://" }, "label": { "type": "string" } }
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["title", "text"],
              "properties": {
                "title": { "type": "string" },
                "text": { "type": "string" },
                "helper": {
                  "type": "object",
                  "required": ["guideId", "label"],
                  "properties": { "guideId": { "type": "string" }, "label": { "type": "string" } }
                },
                "image": {
                  "type": "object",
                  "required": ["src", "alt", "captured"],
                  "properties": {
                    "src": { "type": "string", "pattern": "^assets/img/[a-z0-9-]+\\.(png|jpg|webp)$" },
                    "alt": { "type": "string" },
                    "captured": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
