{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "providers"],
  "properties": {
    "schemaVersion": { "enum": [1] },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "summary", "officialUrl", "apiKeyUrl", "apiProtocol", "freeTier", "creditCardRequired", "requiresIdentityVerification", "availableInIsrael", "supportedModels", "rateLimits", "resetPolicy", "dataUsedForTrainingOnFree", "privacyNotes", "ageRestrictions", "signupEase", "verificationLevel", "lastVerified", "officialSources", "guideId"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$" },
          "name": { "type": "string" },
          "summary": { "type": "string" },
          "officialUrl": { "type": "string", "pattern": "^https://" },
          "apiKeyUrl": { "type": "string", "pattern": "^https://" },
          "apiProtocol": { "type": "array", "items": { "enum": ["native", "openai-chat-completions", "openai-responses"] } },
          "freeTier": { "enum": ["yes", "partial", "no", "not_verified"] },
          "creditCardRequired": { "enum": ["yes", "no", "not_verified"] },
          "requiresIdentityVerification": { "enum": ["none", "phone", "id", "not_verified"] },
          "availableInIsrael": { "enum": ["yes", "no", "not_verified"] },
          "supportedModels": { "type": "array", "items": { "type": "string" } },
          "rateLimits": { "type": "string" },
          "resetPolicy": { "type": "string" },
          "dataUsedForTrainingOnFree": { "enum": ["yes", "no", "not_verified"] },
          "privacyNotes": { "type": "string" },
          "ageRestrictions": { "type": "string" },
          "signupEase": { "type": "number" },
          "verificationLevel": { "enum": ["desk_research", "partially_verified", "manually_verified"] },
          "lastVerified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "officialSources": { "type": "array", "items": { "type": "string", "pattern": "^https://" } },
          "guideId": { "type": "string" }
        }
      }
    }
  }
}
